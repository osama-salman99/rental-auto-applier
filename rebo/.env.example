# Settings for running this crawler yourself. Copy to .env, fill it in, and never commit .env.

# Exactly the value the login service (osmosis-auth) was given: the login cookie is signed with
# it, and with any other value every visitor is turned away.
SSO_SIGNING_KEY=

# The domain the login and this crawler live under, as set in the login service.
# Use localhost to run everything on one machine.
OSMOSIS_AUTH_DOMAIN=example.org

# Where the login is. Default https://auth.<domain>/; for localhost, http://localhost:8210/.
#OSMOSIS_AUTH_URL=

# The name given to whoever is signed in. Default osmosis.
#ADMIN_USERNAME=

# Registering interest in new matching homes by itself. Off unless REBO_AUTOAPPLY_ENABLED=true, and
# while REBO_AUTOAPPLY_DRY_RUN stays true it only logs what it would have sent. The applicant's
# details go out with every registration, so they are set only here. A value set here replaces the
# stored one on every start; leave a line out to keep what is stored.
#REBO_AUTOAPPLY_ENABLED=false
#REBO_AUTOAPPLY_DRY_RUN=true
#REBO_AUTOAPPLY_FIRST_NAME=
#REBO_AUTOAPPLY_LAST_NAME=
#REBO_AUTOAPPLY_EMAIL=
#REBO_AUTOAPPLY_PHONE=
# Gross monthly income in whole euros. Without it nothing is applied to; with it, only homes whose
# rent including service costs is at most about a quarter of it.
#REBO_AUTOAPPLY_INCOME=
# Employer, Entrepreneur, Equity, Pension or SocialBenefit. Default Employer.
#REBO_AUTOAPPLY_INCOME_TYPE=
