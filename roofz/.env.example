# Settings for running this crawler yourself. Copy to .env, fill it in, and never commit .env.

# Exactly the value the login service (osmosis-auth) was given: the login cookie is signed with
# it, and with any other value every visitor is turned away.
SSO_SIGNING_KEY=

# The domain the login and this crawler live under, as set in the login service.
# Use localhost to run everything on one machine.
OSMOSIS_AUTH_DOMAIN=example.org

# Where the login is. Default https://auth.<domain>/; for localhost, http://localhost:8210/.
#OSMOSIS_AUTH_URL=

# The name given to whoever is signed in. Default osmosis.
#ADMIN_USERNAME=

# Where this crawler is reached, for links inside its alerts. Default https://roofz.<domain>.
#ROOFZ_PUBLIC_URL=

# Optional: a JSON file with the full-application profile, read on the first start while the
# database has none. Without it, fill the profile in on the Documents page.
# src/test/resources/applicant-profile.json shows the shape, with made-up values.
#ROOFZ_APPLICANT_PROFILE=

# The ReletPortal (roofz.onosre.com) account the application pipeline signs in with. Without it
# the crawler still watches listings, sends alerts and applies through roofz.eu's own form.
#RELETPORTAL_EMAIL=
#RELETPORTAL_PASSWORD=

# Shared secret for POST /portal/ingest-email, where the portal's emails are delivered. Without it
# that endpoint turns every request away.
#INGEST_TOKEN=

# Optional: when set, the documents already uploaded to this earlier portal application are copied
# into the Documents page on a start while that page is still empty.
#DOCUMENTS_IMPORT_APPLICATION_ID=

# Optional: a phone call through a Twilio Studio flow for every new listing.
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FLOW_SID=
#TWILIO_FROM_NUMBER=
#TWILIO_TO_NUMBER=
