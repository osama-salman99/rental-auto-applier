# Settings for running this crawler yourself. Copy to .env, fill it in, and never commit .env.

# Exactly the value the login service (osmosis-auth) was given: the login cookie is signed with
# it, and with any other value every visitor is turned away.
SSO_SIGNING_KEY=

# The domain the login and this crawler live under, as set in the login service.
# Use localhost to run everything on one machine.
OSMOSIS_AUTH_DOMAIN=example.org

# Where the login is. Default https://auth.<domain>/; for localhost, http://localhost:8210/.
#OSMOSIS_AUTH_URL=

# The name given to whoever is signed in. Default osmosis.
#ADMIN_USERNAME=

# The Vesteda portal account (hurenbij.vesteda.com). Without it the crawler still watches the
# listings and sends alerts, but cannot send or withdraw viewing requests.
#VESTEDA_EMAIL=
#VESTEDA_PASSWORD=

# Optional starting values for the settings page. Income and savings (whole euros) fill the stored
# value only while it is still empty. ENABLED and DRY_RUN are applied on every start while they are
# set; remove them afterwards so the settings page decides again.
#VESTEDA_SEED_INCOME=
#VESTEDA_SEED_SAVINGS=
#VESTEDA_SEED_ENABLED=false
#VESTEDA_SEED_DRY_RUN=true
