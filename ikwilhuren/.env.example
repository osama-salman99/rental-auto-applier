# Settings for running this crawler yourself. Copy to .env, fill it in, and never commit .env.

# Exactly the value the login service (osmosis-auth) was given: the login cookie is signed with
# it, and with any other value every visitor is turned away.
SSO_SIGNING_KEY=

# The domain the login and this crawler live under, as set in the login service.
# Use localhost to run everything on one machine.
OSMOSIS_AUTH_DOMAIN=example.org

# Where the login is. Default https://auth.<domain>/; for localhost, http://localhost:8210/.
#OSMOSIS_AUTH_URL=

# The name given to whoever is signed in. Default osmosis.
#ADMIN_USERNAME=

# The ikwilhuren.nu account used to request viewings. Without it the crawler still watches the
# listings and sends alerts, but cannot request or withdraw viewings.
#IKWILHUREN_EMAIL=
#IKWILHUREN_PASSWORD=

# Optional: your gross monthly income in whole euros, filled into the settings page when it starts
# while the stored value is still empty.
#IKWILHUREN_SEED_INCOME=
